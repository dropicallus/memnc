# --- transport -------------------------------------------------------------
NATS_URL=nats://nats:4222
# H4 (preferred): per-node NKey identity. Generate once with
#   python scripts/gen_nkeys.py --orchestrator alpha --nodes node-a
# then set NATS_CONF (nats server config) and per-node NATS_NKEYS_SEED.
# The seed REPLACES the shared token entirely (transport-level identity);
# the bus fails closed if the seed file is missing.
#   NATS_CONF=secrets/nats.conf
#   NATS_NKEYS_SEED=/secrets/node-a.nk
# Token mode (fallback, no per-node granularity): the shared token IS the
# mesh auth — change this for anything reachable beyond localhost (compose
# refuses to start without either NATS_CONF or NATS_TOKEN set).
NATS_TOKEN=dev-token
NODE_NAME=node-a
# M9 capability gate: registry writes require an orchestrator grant
# (deny-by-default). Enable for any multi-node deployment:
#   meshctl grant <agent_id>            (CHAIN: write own registry records)
#   meshctl grant <agent_id> --level root --ttl-s 3600
#   meshctl grants / meshctl revoke <agent_id>
MESH_GATE=false

# --- role / worker ---------------------------------------------------------
ROLE=coder
WORKSPACE_ROOT=/workspace
MAX_CONCURRENCY=1
MAX_TOOL_STEPS=12
MCP_ENABLED=true
ALLOW_SHELL=true
SHELL_TIMEOUT_S=120
MAX_OUTPUT_BYTES=65536

# --- workflow --------------------------------------------------------------
MAX_REVISIONS=3
MAX_ATTEMPTS=3
PLANNER_TIMEOUT_S=180
CODER_TIMEOUT_S=600
CRITIC_TIMEOUT_S=180
ORCHESTRATOR_GRACE_S=30
APPLY_ARTIFACTS=true

# --- inference (external; this repo only connects) -------------------------
INFERENCE_PROVIDER=ollama
INFERENCE_BASE_URL=http://host.docker.internal:11434
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_S=180
INFERENCE_MAX_RETRIES=3
# Fallback inference, used when the primary is unreachable (sticky: traffic
# stays on the fallback until the primary is probed healthy again).
# INFERENCE_FALLBACK_PROVIDER=ollama
# INFERENCE_FALLBACK_BASE_URL=http://host.docker.internal:11434
# INFERENCE_FALLBACK_API_KEY=
# "primary=fallback,primary2=fallback2" model name remapping.
# INFERENCE_FALLBACK_MODEL_MAP=qwen2.5:7b=qwen2.5:7b-instruct
MODEL_PLANNER=qwen2.5:7b
MODEL_CODER=qwen2.5-coder:7b
MODEL_CRITIC=llama3.1:8b
NUM_CTX=8192
NUM_PREDICT=4096

# --- misc ------------------------------------------------------------------
LOG_LEVEL=INFO

# T7: model pull whitelist (fnmatch patterns; empty = pull path closed).
# Uncomment to open the pull path for the stock role models:
# MODEL_PULL_WHITELIST=["llama3.2:3b","llama3.1:8b","qwen2.5:7b","qwen2.5-coder:7b","gemma*"]
