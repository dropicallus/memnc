#!/bin/bash
# Pre-commit: same checks as CI (.github/workflows/ci.yml)
# Skip with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-commit: ruff check ..."
.venv/bin/ruff check src tests || {
  echo "pre-commit: ruff failed (git commit --no-verify to skip)" >&2
  exit 1
}

echo "pre-commit: pytest tests/ -q ..."
.venv/bin/python -m pytest tests/ -q || {
  echo "pre-commit: pytest failed (git commit --no-verify to skip)" >&2
  exit 1
}

echo "pre-commit: gitleaks detect ..."
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --no-banner --redact || {
    echo "pre-commit: gitleaks failed (git commit --no-verify to skip)" >&2
    exit 1
  }
else
  echo "pre-commit: gitleaks not installed, skipping"
fi

echo "pre-commit: ok"
